mobile/.pub/
mobile/build/
mobile/app.*.symbols
mobile/app.*.map.json
mobile/android/app/debug
mobile/android/app/profile
mobile/android/app/release
mobile/.build/
mobile/.buildlog/
mobile/.history
mobile/.swiftpm/

